  "participantDispositionContract": {
    "localSessionRecord": {
      "routes": [
        "GET /v1/sessions/get",
        "GET /v1/sessions/page"
      ],
      "disposition": "always present: parked or null",
      "dispositionAt": "always present: park timestamp or null",
      "peer": "preserve peer field presence; older peers may omit both"
    },
    "event": {
      "eventKind": "participant.disposition_changed",
      "category": "participant",
      "envelope": [
        "scopeRef",
        "laneRef"
      ],
      "payload": [
        "disposition",
        "dispositionAt",
        "reservationId"
      ],
      "emission": "same transaction, only on value change; hrc-participant generation 0"
    },
    "clear": {
      "route": "POST /v1/participants/unpark",
      "body": [
        "scopeRef",
        "laneRef (default main)"
      ],
      "effect": "clear-only by exact address; reservation stays held; changed=false appends nothing",
      "refusals": {
        "404": "unknown_session naming scopeRef and laneRef",
        "400": "malformed_request"
      }
    }
  }

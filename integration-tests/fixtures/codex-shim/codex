#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--version" ]]; then
  printf 'codex-cli 0.124.0\n'
  exit 0
fi

if [[ "${1:-}" == "app-server" && "${2:-}" == "--help" ]]; then
  printf 'Usage: codex app-server\n'
  exit 0
fi

printf 'CODEX_FIXTURE_STARTED\n'
exec sleep "${HRC_SHIM_SLEEP:-60}"

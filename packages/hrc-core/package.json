{
  "name": "hrc-core",
  "version": "0.1.0",
  "description": "HRC domain types, selectors, fences, errors, path resolution, and event envelope models",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures/task-id-grammar.json": "./fixtures/task-id-grammar.json"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun ../../scripts/hermetic-test.ts",
    "prepack": "bun ../../scripts/strip-bun-exports.ts",
    "postpack": "git checkout HEAD -- package.json"
  },
  "dependencies": {
    "agent-scope": "latest",
    "spaces-runtime-contracts": "latest"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.8.3"
  }
}

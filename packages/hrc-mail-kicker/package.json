{
  "name": "hrc-mail-kicker",
  "version": "0.1.0",
  "description": "HRC execution policy for presenting wrkq collaboration envelopes to agent runtimes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 10000",
    "prepack": "bun ../../scripts/strip-bun-exports.ts",
    "postpack": "git checkout HEAD -- package.json"
  },
  "dependencies": {
    "agent-scope": "latest",
    "hrc-core": "*",
    "hrc-store-sqlite": "*",
    "spaces-harness-broker-protocol": "latest"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.8.3"
  }
}

# Paths that cannot change what code validation proves.
#
# `scripts/run-if-code-changed.ts` reads this file to decide whether a staged
# set (pre-commit) or a pushed commit range (pre-push) is worth spending the
# build/typecheck/test suites on. A path NOT matched here is code: the list is
# an explicit allowance, never a default, so a new top-level directory pays for
# validation until someone decides otherwise.
#
# Syntax is gitignore-shaped and documented in scripts/lib/hook-scope-ignore.ts.
# Matching is case-insensitive. `!` re-includes a path and forces validation.
#
# This list governs HOOK SCOPE only. The install gates answer a different
# question and keep their own classifier in scripts/lib/install-source-scope.ts;
# widening one is not evidence for widening the other.

# Prose and durable records ABOUT the system rather than inputs to it. No build
# step reads them, no package packs them, and no installed command changes when
# they do. `architecture/` holds the invariant and risk records plus their
# generated INVARIANTS.md and index.jsonl projections; those are graded by the
# unconditional `architecture-records` hook command, not by the code suites.
docs/
architecture/

# Arris documents (native .arris.json, declarations, boards) and their rendered
# preview PNGs. Nothing builds, packs or loads them, and Biome ignores *.json,
# so no suite has anything to grade (Lance, 2026-10-31).
/diagrams/

# Prose wherever it sits, including beside the code it describes. No tracked
# file with one of these extensions is loaded at runtime or packed into a
# published package; if that ever changes, the file stops being documentation
# and this list stops covering it.
*.md
*.markdown
*.html
*.htm
*.txt

# Rust has its own cargo leg (.hookignore-cargo); no bun suite consumes it.
/crates/
# TypeScript generators under crates/ are code.
!/crates/**/*.ts

# The parity harness (Python, JSON, Node .mjs, harness-only .ts) is exercised
# by the cargo-leg drivers. No Bun check, lint, typecheck or test covers it, so a
# harness-only change runs no Bun verify (Lance, 2026-10-26).
/conformance/
/contract/
